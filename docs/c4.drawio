<mxfile host="app.diagrams.net"><diagram id="p0" name="Контекст"><mxGraphModel dx="1220" dy="720" grid="1" gridSize="10" page="1" pageWidth="1220" pageHeight="720"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="nu" value="&lt;b style=&quot;font-size:16px&quot;&gt;Маркетолог / аналитик&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;[Человек]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Следит за упоминаниями брендов в новостях&lt;/span&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#ffffff;strokeColor=none;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="465" y="30" width="290" height="130" as="geometry"/></mxCell><mxCell id="ns" value="&lt;b style=&quot;font-size:16px&quot;&gt;Система анализа новостного контента&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;[Программная система]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Пересказ новостей и тональность упоминаний организаций&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#ffffff;strokeColor=none;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="465" y="290" width="290" height="150" as="geometry"/></mxCell><mxCell id="ng" value="&lt;b style=&quot;font-size:16px&quot;&gt;Новостные источники&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;[Внешняя система: Gazeta, RuSentNE]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Тексты новостей и разметка тональности&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#8C8C8C;fontColor=#ffffff;strokeColor=none;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="270" height="130" as="geometry"/></mxCell><mxCell id="nh" value="&lt;b style=&quot;font-size:16px&quot;&gt;Hugging Face Hub&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;[Внешняя система]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Базовая модель Qwen2.5-1.5B-Instruct, наборы данных&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#8C8C8C;fontColor=#ffffff;strokeColor=none;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="910" y="300" width="270" height="130" as="geometry"/></mxCell><mxCell id="nd" value="&lt;b style=&quot;font-size:16px&quot;&gt;Google Drive&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;[Внешнее хранилище]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Данные, адаптеры LoRA, отчёты, база MLflow&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#8C8C8C;fontColor=#ffffff;strokeColor=none;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="465" y="560" width="290" height="130" as="geometry"/></mxCell><mxCell id="e0" value="Смотрит пересказы и дашборд брендов" style="endArrow=block;endFill=1;html=1;dashed=1;strokeColor=#555555;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="nu" target="ns"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="Тексты новостей" style="endArrow=block;endFill=1;html=1;dashed=1;strokeColor=#555555;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ng" target="ns"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="Модель и данные" style="endArrow=block;endFill=1;html=1;dashed=1;strokeColor=#555555;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="nh" target="ns"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="Читает и записывает" style="endArrow=block;endFill=1;html=1;dashed=1;strokeColor=#555555;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ns" target="nd"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p1" name="Контейнеры"><mxGraphModel dx="1850" dy="960" grid="1" gridSize="10" page="1" pageWidth="1850" pageHeight="960"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="B" value="Система анализа новостного контента [Google Colab, GPU T4]" style="rounded=1;arcSize=2;dashed=1;dashPattern=10 6;fillColor=none;strokeColor=#666666;strokeWidth=2;verticalAlign=bottom;align=right;spacingRight=12;spacingBottom=8;fontStyle=1;fontSize=15;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="300" y="180" width="1170" height="560" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b style=&quot;font-size:16px&quot;&gt;Загрузка и проверка данных&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;[datasets, pandera, datasketch]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Gazeta и RuSentNE, проверка качества и утечки&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#ffffff;strokeColor=none;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="340" y="240" width="270" height="130" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b style=&quot;font-size:16px&quot;&gt;Обучение LoRA&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;[PEFT, TRL, bitsandbytes]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;QLoRA-адаптеры для Qwen2.5-1.5B-Instruct&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#ffffff;strokeColor=none;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="750" y="240" width="270" height="130" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b style=&quot;font-size:16px&quot;&gt;Трекинг экспериментов&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;[MLflow, SQLite]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Параметры, кривые loss и метрики запусков&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#ffffff;strokeColor=none;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1160" y="240" width="270" height="130" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b style=&quot;font-size:16px&quot;&gt;Тональность и мониторинг брендов&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;[scikit-learn, natasha, Plotly]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Тональность к организациям, дашборд&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#ffffff;strokeColor=none;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="340" y="560" width="270" height="130" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b style=&quot;font-size:16px&quot;&gt;Демо-интерфейс&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;[Gradio]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Пересказ и тональность введённой новости&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#ffffff;strokeColor=none;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="750" y="560" width="270" height="130" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b style=&quot;font-size:16px&quot;&gt;Оценка&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;[ROUGE, bootstrap, natasha NER]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Метрики, доверительные интервалы, галлюцинации&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#ffffff;strokeColor=none;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1160" y="560" width="270" height="130" as="geometry"/></mxCell><mxCell id="nhf" value="&lt;b style=&quot;font-size:16px&quot;&gt;Hugging Face Hub&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;[Внешняя система]&lt;/spa